generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Estudiante {
  id         String      @id @default(uuid())
  documento  String      @unique
  nombres    String
  apellidos  String
  correo     String      @unique
  telefono   BigInt?
  matriculas Matricula[]

  @@map("estudiantes")
}

model Materia {
  id         String      @id @default(uuid())
  nombre     String
  creditos   Int
  matriculas Matricula[]

  @@map("materias")
}

model PeriodoAcademico {
  id             String      @id @default(uuid())
  nombre_periodo String
  fecha_inicio   DateTime
  fecha_fin      DateTime
  actual         Boolean     @default(false)
  matriculas     Matricula[]

  @@map("periodos_academicos")
}

model Matricula {
  id                   String   @id @default(uuid())
  estudiante_id        String
  materia_id           String
  periodo_academico_id String
  estado               String   @default("activa")
  fecha_matricula      DateTime @default(now())

  estudiante        Estudiante       @relation(fields: [estudiante_id], references: [id])
  materia           Materia          @relation(fields: [materia_id], references: [id])
  periodo_academico PeriodoAcademico @relation(fields: [periodo_academico_id], references: [id])
  notas             Nota[]

  @@unique([estudiante_id, materia_id, periodo_academico_id])
  @@index([estudiante_id])
  @@index([materia_id])
  @@index([periodo_academico_id])
  @@map("matriculas")
}

model Nota {
  id           String   @id @default(uuid())
  matricula_id String
  tipo_nota    String
  puntaje      Float
  fecha_nota   DateTime @default(now())

  matricula Matricula @relation(fields: [matricula_id], references: [id])

  @@index([matricula_id])
  @@map("notas")
}
